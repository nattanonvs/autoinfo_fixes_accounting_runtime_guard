<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="project_project_form" model="ir.ui.view">
        <field name="name">project.project.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <field name="company_id" position="before">
                <field name="job_type"/>
                <field name="project_department_id"/>
                <field name="sale_person_id"/>
                <field name="job_no"/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page name="tab_quotation" string="Quotation">
                    <field name="project_sale_order_ids" readonly="1"/>
                </page>
                <page name="tab_po" string="Purchase Orders">
                    <field name="project_po_ids" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="project_project_simplified_form" model="ir.ui.view">
        <field name="name">project.project.simplified.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.project_project_view_form_simplified"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="job_type"/>
                <field name="project_department_id"/>
                <field name="sale_person_id"/>
            </field>
        </field>
    </record>
</odoo>