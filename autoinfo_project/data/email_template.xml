<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_project_task_notice_deadline_template" model="mail.template">
            <field name="name">Project Task Notice Deadline - Email Template</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="auto_delete" eval="True" />
            <field name="subject">Project Task {{ ctx.get('data').name }} Deadline</field>
            <field name="email_to">{{ ctx.get('email_to') }}</field>
            <field name="email_from">"{{ object.company_id.name }}" &lt;{{ (object.company_id.email or user.email) }}&gt;</field>
            <field name="body_html" type="html">
                <t t-set="ctx_user" t-value="ctx.get('team')"/>
                <div>
                    Dear <t t-out="ctx_user.name"/><br/>
                    Detail as below<br/>
                    Task: <t t-esc="object.name"/><br/>
                    Deadline: <t t-esc="object.date_deadline.strftime('%d/%m/%Y') or '-'"/>
                    <br/><br/><br/>
                </div>
                <div style="margin-left:30px;align=center;" width="60%">
                    <a t-att-href="ctx.get('action_url')" style="background-color: #1abc9c; padding: 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;" class="o_default_snippet_text">Go to Project Task</a>
                    <br/><br/>
                </div><br/>

                <p>Thank you,</p>
            </field>
        </record>
    </data>
</odoo>