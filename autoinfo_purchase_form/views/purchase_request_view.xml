<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_request_form" model="ir.ui.view">
        <field name="name">purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="priority">60</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="purchase_report" string="Report">
                    <group>
                        <group>
                            <field name="dtr_purchase_delivery_to_report_id"/>
                            <field name="delivery_to_report"/>
                            <field name="delivery_date_report"/>
                            <field name="dtr_purchase_warranty_report_id"/>
                            <field name="dtr_purchase_term_report_id"/>
                            <field name="dtr_purchase_shipment_report_id"/>
                            <field name="dtr_purchase_weight_report_id"/>
                        </group>
                        <group>
                            <field name="shipping_standard"/>
                            <field name="tariff"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='line_ids']//tree//field[@name='date_required']" position="after">
                <field name="autoinfo_list_price" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>