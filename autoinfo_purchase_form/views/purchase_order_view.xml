<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="purchase_order_form" model="ir.ui.view">
            <field name="name">purchase.order.form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <field name="partner_ref" position="after">
                    <field name="your_ref"/>
                </field>
                <xpath expr="//notebook" position="inside">
                    <page name="purchase_report" string="Report">
                        <group>
                            <group>
                                <field name="delivery_to_report"/>
                                <field name="delivery_date_report"/>
                                <field name="warranty_report"/>
                                <field name="weight_report"/>
                            </group>
                            <group>
                                <field name="discount_report"/>
                                <field name="shipping_standard"/>
                                <field name="tariff"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>