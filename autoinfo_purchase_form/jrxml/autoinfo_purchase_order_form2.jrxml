		<property name="com.jaspersoft.studio.field.tree.path" value="product_product"/>
	</field>
	<field name="product_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="product_name"/>
	</field>
	<field name="product_qty" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.label" value="product_qty"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="purchase_order_line"/>
	</field>
