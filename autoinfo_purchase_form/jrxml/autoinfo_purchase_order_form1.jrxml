						<font fontName="Arial Unicode" size="10" isBold="false" isUnderline="false"/>
						<paragraph leftIndent="1" rightIndent="0" spacingBefore="3"/>
					</textElement>
					<textFieldExpression><![CDATA["3.หากไม่สามารถมารับเช็คได้ในวันที่จ่ายเช็คต้องโทรแจ้งก่อน หากไม่แจ้งจะได้รับเช็คในรอบจ่ายเดือนถัดไป"]]></textFieldExpression>
