						<paragraph leftIndent="1" rightIndent="0" spacingBefore="3"/>
					</textElement>
					<textFieldExpression><![CDATA["1.รับวางบิลทุกวันพฤหัส เวลา 8.30-17.00  พร้อมแนบใบสั่งซื้อ และใบกำกับภาษีตัวจริง ถ้าไม่มีไม่รับวางบิล"]]></textFieldExpression>
				</textField>
