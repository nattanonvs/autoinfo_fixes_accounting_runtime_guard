						<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<textElement textAlignment="Left" verticalAlignment="Top" markup="none">
						<font fontName="Arial Unicode" size="10" isBold="false" isUnderline="false"/>
						<paragraph leftIndent="1" rightIndent="0" spacingBefore="3"/>
					</textElement>
					<textFieldExpression><![CDATA["2.จ่ายเช็คทุกวันศุกร์ที่ 3 ของเดือน  เวลา 13.00-17.00 น. โดยนับเครดิตจากวันวางบิล"]]></textFieldExpression>
				</textField>
