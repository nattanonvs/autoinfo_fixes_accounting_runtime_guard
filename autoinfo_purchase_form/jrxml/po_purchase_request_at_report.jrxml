	<queryString>
		<![CDATA[SELECT p.id as p_id, pl.sequence as pl_seq, pl.id as pl_id
	,c1.name as company_name
	,encode(c2.company_logo,'escape') AS company_logo
	,att.store_fname AS company_logo_iso
	--,COALESCE(rp.default_contact_name, '') as partner_contact_name
	,(SELECT COALESCE(b.name,'') FROM res_users a LEFT JOIN res_partner b ON b.id=a.partner_id WHERE a.id=p.attention_id) as partner_contact_name
	,rp.display_name as partner_name
	,concat(rp.street) as partner_address_1
	,concat(rp.street2) as partner_address_2
	,rp.ref as partner_code
	,case when rp.branch_code is null OR rp.branch_code='00000' THEN 'สำนักงานใหญ่' ELSE rp.branch_code END as partner_branch_code 
	,rp.vat as partner_tax
	,rp.phone as partner_phone
	,rp.mobile as partner_mobile
	,rp.fax as partner_fax
	,rp.email as partner_email

	,p.name as p_name
	,p.date_start as p_date_start
	,COALESCE(p.your_ref, '') as p_your_ref
	,COALESCE(proj.name, '') as p_project_name
	,COALESCE(pdr.description, '') as p_delivery_to_report
	,COALESCE(p.delivery_to_report, '') as p_delivery_report_other
	,p.delivery_date_report as p_delivery_date_report
	,COALESCE(pwr.description, '') as p_warranty_report
	,COALESCE(ptr.description, '') as p_payment_term
	,p.estimated_cost as p_estimated_cost
	,p.amount_untaxed_before_discount as p_amount_untaxed_before_discount
	,p.amount_discount as p_amount_discount
	,p.amount_untaxed as p_amount_untaxed
	,p.amount_tax as p_amount_tax
	,p.amount_total as p_amount_total

	,convert_num_th_with_currency(CAST(p.amount_total as numeric(14,2)), p.currency_id) AS bahttext
	,convert_num_en_with_currency(CAST(p.amount_total as numeric(14,2)), p.currency_id) AS bahttext_en
	,cur.name as currency_name
	,0 as seq,

	pro.default_code AS product_code,
	REPLACE(pl.name, CONCAT('[', pro.default_code, ']'), '') AS product_name,
	pl.product_qty AS product_qty,
	uom.name AS product_uom,
	--CASE WHEN pl.product_qty is null OR pl.product_qty=0.0 THEN 0.0 ELSE CAST(pl.estimated_cost/pl.product_qty as numeric(14,2)) END AS product_price_unit,
	pl.price_unit AS product_price_unit,
       case 
               when pl.discount_type = 'amount_per_unit' 
               then pl.discount * pl.product_qty
               else pl.discount
       end AS product_discount,
        case 
               when pl.discount_type = 'percent' 
               then '%'
               else ''
       end AS product_discount_sign,
	pl.price_subtotal AS product_price_subtotal,
	pl.display_type

  --__________________________________
	,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id=p.requested_by) AS requested_name
	,(SELECT b.name_en FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id=p.requested_by) AS requested_name_en
	,(SELECT c.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_job c ON c.id = b.job_id
		WHERE a.user_id=p.requested_by) AS requested_position
	,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id=p.requested_by) AS requested_signature			   

  --__________________________________
	,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT done_by 
						   FROM tier_review 
						   WHERE model='purchase.request' AND res_id=p.id AND status='approved'
						   ORDER BY sequence DESC LIMIT 1)) AS approved_name
	,(SELECT b.name_en FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT done_by 
						   FROM tier_review 
						   WHERE model='purchase.request' AND res_id=p.id AND status='approved'
						   ORDER BY sequence DESC LIMIT 1)) AS approved_name_en
	,(SELECT c.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_job c ON c.id = b.job_id
		WHERE a.user_id = (SELECT done_by 
						   FROM tier_review 
						   WHERE model='purchase.request' AND res_id=p.id AND status='approved'
						   ORDER BY sequence DESC LIMIT 1)) AS approved_position
	,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = (SELECT done_by 
						   FROM tier_review 
						   WHERE model='purchase.request' AND res_id=p.id AND status='approved'
						   ORDER BY sequence DESC LIMIT 1)) AS approved_signature
       
FROM purchase_request_line pl
JOIN purchase_request p ON p.id=pl.request_id
JOIN res_company c1 ON c1.id=p.company_id
LEFT JOIN company_address_header_report c2 ON c2.id=p.company_id
LEFT JOIN ir_attachment att ON att.res_id=c1.id AND att.res_model='res.company' AND att.res_field='logo_iso'

LEFT JOIN res_partner rp ON rp.id=p.partner_id
JOIN res_currency cur ON cur.id=p.currency_id
LEFT JOIN project_project proj ON p.project_id=proj.id
LEFT JOIN dtr_purchase_warranty_report pwr ON pwr.id=p.dtr_purchase_warranty_report_id
LEFT JOIN dtr_purchase_delivery_to_report pdr ON pdr.id=p.dtr_purchase_delivery_to_report_id
LEFT JOIN dtr_purchase_term_report ptr ON ptr.id=p.dtr_purchase_term_report_id

LEFT JOIN product_product pro ON pro.id=pl.product_id
LEFT JOIN uom_uom uom ON uom.id=pl.product_uom_id

$P!{p_PRNo}
--WHERE p.id in (536,537)
ORDER BY p_id, pl_seq, pl_id;]]>
	</queryString>
