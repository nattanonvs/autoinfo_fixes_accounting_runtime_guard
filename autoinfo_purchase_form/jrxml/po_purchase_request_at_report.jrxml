	<parameter name="p_Path" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["/odoo15_dtr/.local/share/Odoo/filestore/autoinfo_16012023/"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_ISO" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT p.id as p_id, pl.sequence as pl_seq, pl.id as pl_id
	,c1.name as company_name
	,encode(c2.company_logo,'escape') AS company_logo
	,att.store_fname AS company_logo_iso
	,COALESCE(rp.default_contact_name, '') as partner_contact_name
	,rp.display_name as partner_name
	,concat(rp.street) as partner_address_1
	,concat(rp.street2) as partner_address_2
	,rp.ref as partner_code
	,rp.vat as partner_tax
	,case when rp.branch_code is null OR rp.branch_code='00000' THEN 'สำนักงานใหญ่' ELSE rp.branch_code END as partner_branch_code 
	,rp.vat as partner_tax
	,rp.phone as partner_phone
	,rp.mobile as partner_mobile
	,rp.fax as partner_fax
	,rp.email as partner_email

	,p.name as p_name
	,p.date_start as p_date_start
	,COALESCE(p.your_ref, '') as p_your_ref
	,COALESCE(proj.name, '') as p_project_name
	,COALESCE(pdr.description, '') as p_delivery_to_report
	,COALESCE(p.delivery_to_report, '') as p_delivery_report_other
	,p.delivery_date_report as p_delivery_date_report
	,COALESCE(pwr.description, '') as p_warranty_report
	,COALESCE(ptr.description, '') as p_payment_term
	,cur.name AS currency_name

FROM purchase_request_line pl
JOIN purchase_request p ON p.id=pl.request_id
JOIN res_company c1 ON c1.id=p.company_id
LEFT JOIN company_address_header_report c2 ON c2.id=p.company_id
LEFT JOIN ir_attachment att ON att.res_id=c1.id AND att.res_model='res.company' AND att.res_field='logo_iso'

JOIN res_partner rp ON rp.id=p.partner_id
JOIN res_currency cur ON cur.id=p.currency_id
LEFT JOIN project_project proj ON p.project_id=proj.id
LEFT JOIN dtr_purchase_warranty_report pwr ON pwr.id=p.dtr_purchase_warranty_report_id
LEFT JOIN dtr_purchase_delivery_to_report pdr ON pdr.id=p.dtr_purchase_delivery_to_report_id
LEFT JOIN dtr_purchase_term_report ptr ON ptr.id=p.dtr_purchase_term_report_id

$P!{p_PRNo}
ORDER BY p_id, pl_seq, pl_id;]]>
	</queryString>
