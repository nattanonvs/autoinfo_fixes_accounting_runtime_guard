<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="account_move_form" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='button_cancel'][2]" position="replace">
                    <button name="%(autoinfo_account.action_account_move_cancel)d" string="Cancel" type="action" groups="account.group_account_invoice" data-hotkey="w" attrs="{'invisible' : ['|', '|', ('id', '=', False), ('state', '!=', 'draft'),('move_type', '==', 'entry')]}" context="{'default_account_move_id': id}"/>
                </xpath>
                <xpath expr="//div[@name='journal_div']" position="after">
                    <field name="cancel_reason" attrs="{'invisible': ['|', ('state', '!=', 'cancel'), ('move_type', '==', 'entry')]}"/>
                    <field name="dtr_customer_ref" attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>