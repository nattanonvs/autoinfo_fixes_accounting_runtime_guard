<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_request_dtr_purchase_form" model="ir.ui.view">
        <field name="name">purchase.request.dtr.purchase.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="dtr_purchase.purchase_request_form"/>
        <field name="arch" type="xml">
            <field name="project_id" position="after">
                <field name="job_no" attrs="{'invisible': [('job_no', 'in', [False, ''])]}"/>
            </field>
        </field>
    </record>

    <record id="purchase_request_form" model="ir.ui.view">
        <field name="name">purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <field name="requested_by" position="after">
                <field name="project_analytic_account_id" invisible="1"/>
            </field>
            <field name="line_ids" position="attributes">
                <attribute name="context">{'default_analytic_account_id': project_analytic_account_id}</attribute>
            </field>
        </field>
    </record>
</odoo>