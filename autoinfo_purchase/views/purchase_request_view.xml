<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_request_dtr_purchase_form" model="ir.ui.view">
        <field name="name">purchase.request.dtr.purchase.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="dtr_purchase.purchase_request_form"/>
        <field name="arch" type="xml">
            <field name="project_id" position="after">
                <field name="job_no" attrs="{'invisible': [('job_no', 'in', [False, ''])]}"/>
            </field>
        </field>
    </record>

    <record id="purchase_request_form" model="ir.ui.view">
        <field name="name">purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <field name="requested_by" position="after">
                <field name="project_analytic_account_id" invisible="1"/>
                <field name="attention_id" attrs="{'readonly': [('is_editable','=', False)]}"/>
            </field>
            <field name="line_ids" position="attributes">
                <attribute name="context">{'default_analytic_account_id': project_analytic_account_id}</attribute>
            </field>
            <field name="dtr_document_sequence_group_id" position="before">
                <field name="partner_id" widget="res_partner_many2one" context="{'res_partner_search_mode': 'supplier', 'show_vat': True}"
                    attrs="{'readonly': [('is_editable','=', False)], 'required': False}" domain="[('supplier', '=', True)]"
                    force_save="1" placeholder="Name, TIN, Email, or Reference"
                    options="{'always_reload': True, 'no_quick_create':True,'no_create_edit':True}"/>
                <field name="your_ref"/>
            </field>
            <xpath expr="//field[@name='line_ids']//tree//field[@name='purchase_state']" position="replace">
                <field name="purchase_state"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']//tree//field[@name='date_required']" position="after">
                <field name="price_unit" optional="show"/>
                <field name="discount" optional="show"/>
                <field name="discount_type" optional="show"/>
                <field name="taxes_id" widget="many2many_tags" domain="[('type_tax_use','=','purchase'), ('company_id', '=', parent.company_id)]" context="{'default_type_tax_use': 'purchase', 'search_view_ref': 'account.account_tax_view_search'}" options="{'no_create': True}" optional="show"/>
                <field name="price_subtotal" widget="monetary" optional="show"/>
                <field name="price_total" invisible="1"/>
                <field name="price_tax" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']//tree//field[@name='estimated_cost']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//page[1]//group[1]" position="replace">
                <group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="estimated_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </group>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="amount_untaxed_before_discount" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                        <field name="amount_discount" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                        <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <div class="oe_subtotal_footer_separator oe_inline">
                            <label for="amount_total" style="font-weight:700;"/>
                        </div>
                        <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    </group>
                </group>
                <div class="oe_clear"/>
            </xpath>
        </field>
    </record>
</odoo>