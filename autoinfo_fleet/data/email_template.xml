<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="email_fleet_service_notification" model="mail.template">
            <field name="name">Fleet Service Notification - Email Template</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle_log_services"/>
            <field name="auto_delete" eval="True" />
            <field name="subject">Fleet Service Notification of {{ ctx.get('data').vehicle_id.name }} Successfully</field>
            <field name="email_to">{{ ctx.get('email_to') }}</field>
            <field name="email_from">"{{ object.company_id.name }}" &lt;{{ (object.company_id.email or user.email) }}&gt;</field>
            <field name="body_html" type="html">
                <div>
                    Dear <t t-out="object.purchaser_id.name"/><br/>
                    Detail as below<br/>
                    Vehicle: <t t-esc="object.vehicle_id.name"/><br/>
                    Description: <t t-esc="object.description"/><br/>
                    Note: <t t-esc="object.notes"/><br/>
                    <br/><br/><br/>
                </div>
                <div style="margin-left:30px;align=center;" width="60%">
                    <a t-att-href="ctx.get('action_url')" style="background-color: #1abc9c; padding: 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;" class="o_default_snippet_text">Go to Fleet Service</a>
                    <br/><br/>
                </div><br/>

                <p>Thank you,</p>
            </field>
        </record>

        <record id="email_vehicle_insurance_notification" model="mail.template">
            <field name="name">Vehicle Insurance Notification - Email Template</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle"/>
            <field name="auto_delete" eval="True" />
            <field name="subject">Vehcile {{ ctx.get('data').name }} Insurance is Expiring</field>
            <field name="email_to">{{ ctx.get('email_to') }}</field>
            <field name="email_from">"{{ object.company_id.name }}" &lt;{{ (object.company_id.email or user.email) }}&gt;</field>
            <field name="body_html" type="html">
                <div>
                    Dear <t t-out="object.driver_id.name"/><br/>
                    Detail as below<br/>
                    Vehicle: <t t-esc="object.name"/><br/>
                    Insurance Expire Date: <t t-esc="object.insurance_expire_date.strftime('%d/%m/%Y') or '-'"/>
                    <br/><br/><br/>
                </div>
                <div style="margin-left:30px;align=center;" width="60%">
                    <a t-att-href="ctx.get('action_url')" style="background-color: #1abc9c; padding: 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;" class="o_default_snippet_text">Go to Fleet Vehicle</a>
                    <br/><br/>
                </div><br/>

                <p>Thank you,</p>
            </field>
        </record>

        <record id="email_vehicle_act_notification" model="mail.template">
            <field name="name">Vehicle Act Notification - Email Template</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle"/>
            <field name="auto_delete" eval="True" />
            <field name="subject">Vehcile {{ ctx.get('data').name }} Act is Expiring</field>
            <field name="email_to">{{ ctx.get('email_to') }}</field>
            <field name="email_from">"{{ object.company_id.name }}" &lt;{{ (object.company_id.email or user.email) }}&gt;</field>
            <field name="body_html" type="html">
                <div>
                    Dear <t t-out="object.driver_id.name"/><br/>
                    Detail as below<br/>
                    Vehicle: <t t-esc="object.name"/><br/>
                    Act Expire Date: <t t-esc="object.act_expire_date.strftime('%d/%m/%Y') or '-'"/>
                    <br/><br/><br/>
                </div>
                <div style="margin-left:30px;align=center;" width="60%">
                    <a t-att-href="ctx.get('action_url')" style="background-color: #1abc9c; padding: 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;" class="o_default_snippet_text">Go to Fleet Vehicle</a>
                    <br/><br/>
                </div><br/>

                <p>Thank you,</p>
            </field>
        </record>
    </data>
</odoo>