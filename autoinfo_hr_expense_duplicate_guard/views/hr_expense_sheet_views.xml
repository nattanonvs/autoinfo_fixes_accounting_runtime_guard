<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_expense_sheet_form_duplicate_guard" model="ir.ui.view">
        <field name="name">hr.expense.sheet.form.duplicate.guard</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='expenses']" position="after">
                <page string="Duplicate Review">
                    <group>
                        <label
                            for="expense_line_ids"
                            string="Review duplicate warnings before approval."
                        />
                    </group>
                </page>
            </xpath>
            <xpath expr="//page[@name='expenses']/field[@name='expense_line_ids']/tree/field[@name='name']" position="after">
                <field name="duplicate_check_state" optional="show"/>
                <field name="duplicate_summary" optional="show"/>
                <field name="duplicate_override_reason" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
