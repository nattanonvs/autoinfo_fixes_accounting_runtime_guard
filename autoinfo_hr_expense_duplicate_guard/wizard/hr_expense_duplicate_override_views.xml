<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_expense_duplicate_override_form" model="ir.ui.view">
        <field name="name">hr.expense.duplicate.override.form</field>
        <field name="model">hr.expense.duplicate.override</field>
        <field name="arch" type="xml">
            <form string="Override Duplicate Block">
                <group>
                    <field name="expense_id" readonly="1"/>
                    <field
                        name="reason"
                        placeholder="Explain why this expense should pass despite duplicate detection"
                    />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Confirm Override"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
