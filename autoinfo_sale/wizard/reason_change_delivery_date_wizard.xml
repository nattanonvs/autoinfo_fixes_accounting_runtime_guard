<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="reason_change_delivery_date_wizard" model="ir.ui.view">
            <field name="name">reason.change.delivery.date.wizard</field>
            <field name="model">reason.change.delivery.date.wizard</field>
            <field name="arch" type="xml">
                <form string="Reason Change Delivery Date">
                    <group>
                        <field name="delivery_date"/>
                        <field name="reason"/>
                    </group>
                    <footer>
                        <button name="confirm_change_delivery_date" string="Confirm" type="object" class="oe_highlight"  />
                        <button string="Cancel" class="btn-default" special="cancel" />
                    </footer>
               </form>
            </field>
        </record>

        <record id="action_change_delivery_date" model="ir.actions.act_window">
            <field name="name">Reason Change Delivery Date</field>
            <field name="res_model">reason.change.delivery.date.wizard</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="reason_change_delivery_date_wizard"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>