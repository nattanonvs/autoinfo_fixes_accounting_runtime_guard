	<queryString>
		<![CDATA[select
    c.name as company_name
    ,COALESCE(c2.company_name_thai,'') AS company_name_thai
    ,COALESCE(c2.company_name_en,'') AS company_name_en
    ,COALESCE(c2.company_tax_id,'') AS company_tax_id
    ,COALESCE(c2.company_branch,'00000') AS company_branch
    ,encode(c2.company_logo,'escape') AS company_logo      
    ,COALESCE(c2.company_address_thai,'') AS company_address_thai
    ,COALESCE(c2.company_address_en,'') AS company_address_en
    ,COALESCE(c2.company_heaer_report,'') AS company_heaer_report
    ,COALESCE(c2.company_footer_report,'') AS company_footer_report
    ,COALESCE(c2.company_phone,'') AS company_phone
    ,COALESCE(c2.company_fax,'') AS company_fax
    ,COALESCE(c2.company_email,'') AS company_email
    ,COALESCE(c2.company_website,'') AS company_website
    ,pro.job_no AS job_no
    ,pro.name AS job_name
    ,pro.job_type AS job_type
    ,pro.reference_po AS reference_po
    ,emp1.name AS responsible1
    ,emp2.name AS responsible2
    ,emp3.name AS responsible3
    ,emp4.name AS autoinfo_coordinator
    ,pro.customer_coordinator AS customer_coordinator
    ,pro.customer_coordinator_tel AS customer_coordinator_tel
    ,pro.customer_coordinator_email AS customer_coordinator_email
    ,pro.scope_of_work AS scope_of_work
    ,pro.date_start AS date_start
    ,pro.date AS date_end
    ,pro.has_spare_part AS has_spare_part
    ,pro.spare_part AS spare_part
    ,pro.document_required_entry_to_work AS document_required_entry_to_work
    ,pro.maintenance_wo AS maintenance_wo
    ,pro.jsa AS jsa
    ,pro.copy_id_card AS copy_id_card
    ,pro.copy_social_security AS copy_social_security
    ,pro.medeical_certificate AS medeical_certificate
    ,pro.document_required_entry_to_work_other AS document_required_entry_to_work_other
    ,pro.document_required_entry_to_work_other_description AS document_required_entry_to_work_other_description
    ,pro.service_report AS service_report
    ,pro.work_delivery AS work_delivery
    ,pro.list_of_trainees AS list_of_trainees
    ,pro.temporary_delivery AS temporary_delivery
    ,pro.document_required_after_entering_other AS document_required_after_entering_other
    ,pro.document_required_after_entering_other_description AS document_required_after_entering_other_description
    ,pro.tor AS tor
    ,pro.unprice AS unprice
    ,pro.attachment_other AS attachment_other
    ,pro.attachment_other_description AS attachment_other_description
    ,pro.report_remark AS report_remark
    ,att.store_fname AS logo_iso
from project_project pro
left join res_company c on c.id = pro.company_id
left join company_address_header_report c2 ON c2.id = pro.company_id
left join hr_employee emp1 on emp1.id = pro.responsible_person1
left join hr_employee emp2 on emp2.id = pro.responsible_person2
left join hr_employee emp3 on emp3.id = pro.responsible_person3
left join hr_employee emp4 on emp4.id = pro.autoinfo_coordinator
left join ir_attachment att ON att.res_id = c.id and att.res_model = 'res.company' and att.res_field='logo_iso'
$P!{p_Where}]]>
	</queryString>
