<odoo>
    <record id="module_category_knowledge_platform" model="ir.module.category">
        <field name="name">Knowledge Platform</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_knowledge_viewer" model="res.groups">
        <field name="name">Knowledge Viewer</field>
        <field name="category_id" ref="autoinfo_company_knowledge_platform.module_category_knowledge_platform"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_knowledge_contributor" model="res.groups">
        <field name="name">Knowledge Contributor</field>
        <field name="category_id" ref="autoinfo_company_knowledge_platform.module_category_knowledge_platform"/>
        <field name="implied_ids" eval="[(4, ref('autoinfo_company_knowledge_platform.group_knowledge_viewer'))]"/>
    </record>

    <record id="group_knowledge_reviewer" model="res.groups">
        <field name="name">Knowledge Reviewer</field>
        <field name="category_id" ref="autoinfo_company_knowledge_platform.module_category_knowledge_platform"/>
        <field name="implied_ids" eval="[(4, ref('autoinfo_company_knowledge_platform.group_knowledge_contributor'))]"/>
    </record>

    <record id="group_department_manager" model="res.groups">
        <field name="name">Knowledge Department Manager</field>
        <field name="category_id" ref="autoinfo_company_knowledge_platform.module_category_knowledge_platform"/>
        <field name="implied_ids" eval="[(4, ref('autoinfo_company_knowledge_platform.group_knowledge_reviewer'))]"/>
    </record>

    <record id="group_knowledge_admin" model="res.groups">
        <field name="name">Knowledge Admin</field>
        <field name="category_id" ref="autoinfo_company_knowledge_platform.module_category_knowledge_platform"/>
        <field name="implied_ids" eval="[(4, ref('autoinfo_company_knowledge_platform.group_department_manager'))]"/>
    </record>
</odoo>
