<odoo>
    <record id="view_knowledge_submit_review_form" model="ir.ui.view">
        <field name="name">knowledge.submit.review.form</field>
        <field name="model">knowledge.submit.review</field>
        <field name="arch" type="xml">
            <form string="Submit For Review">
                <footer>
                    <button name="action_confirm" type="object" string="Submit" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
