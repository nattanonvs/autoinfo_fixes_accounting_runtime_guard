<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_register_form" model="ir.ui.view">
        <field name="name">view.account.payment.register.form</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//footer" position="before">
                <notebook><page name="wht_page" string="Withholding Tax">
                    <field name="wht_ids" widget="one2many_list" colspan="4" nolabel="1" context="{'default_partner_id': partner_id,'default_pay_amount1': amount}">
                        <tree string="Withholding Tax" create="1" edit="1" delete="1">
                            <field name="payment_id" invisible="1"/>
                            <field name="pay_date"/>
                            <field name="name"/>
                            <field name="payee_name"/>
                            <field name="income_type"/>
                            <field name="pay_amount" string="จำนวนเงิน"/>
                            <field name="wht_amount" string="ภาษี"/>
                            <field name="tax_type"/>
                            <field name="state" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </tree>
                    </field>
                </page></notebook>
            </xpath>
        </field>
    </record>

</odoo>
