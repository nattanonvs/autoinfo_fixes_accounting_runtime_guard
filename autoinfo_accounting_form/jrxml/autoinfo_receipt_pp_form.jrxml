	<parameter name="ids" class="java.lang.String">
		<defaultValueExpression><![CDATA["WHERE pay.id in (3)"]]></defaultValueExpression>
	</parameter>
	<parameter name="iscopy" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="p_DateFormat" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["dd/MM/yyyy"]]></defaultValueExpression>
	</parameter>
