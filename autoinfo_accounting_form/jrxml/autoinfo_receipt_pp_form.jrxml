		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
am.name as pay_no,
invoice.name as inv_no,
convert_num_th_with_currency(pay.amount_net, invoice.currency_id) as total_word,
newdate.newdate as pay_date, 
newdate.newdate_due as invoice_date_due, 
partner.tax_name as customer,
CONCAT(partner.street,' ',partner.street2) AS  partner_address,

(SELECT
case when tax.amount_type = 'percent' then concat(CAST(tax.amount AS INT), '%') 
else tax.amount::varchar
end as tax_text
FROM account_move_line aml
LEFT JOIN account_move_line_account_tax_rel aml_atx on aml_atx.account_move_line_id = aml.id
LEFT JOIN account_tax tax on tax.id = aml_atx.account_tax_id
where aml.move_id = invoice.id and aml.exclude_from_invoice_tab = False and aml.display_type is NULL
LIMIT 1) as tax,

sale.client_order_ref as sale_ref,
sale.po_date as sale_ref_date,
term.name as payment_term,
line.name as line_name,
line.quantity as line_quantity,
line.price_unit as price_unit,
line.price_subtotal as price_subtotal,
sale.user_id,
(SELECT
CONCAT(emp.name,' / ',COALESCE(dep.dtr_department_short, ''))
FROM hr_employee emp
LEFT JOIN hr_department dep on dep.id = emp.department_id
WHERE emp.user_id = salesperson.id and emp.active = True
LIMIT 1) as salesperson,
(SELECT
dep.name
FROM hr_employee emp
LEFT JOIN hr_department dep on dep.id = emp.department_id
WHERE emp.user_id = salesperson.id and emp.active = True
LIMIT 1) as sale_department,

(SELECT
sum(invoice.amount_trade_discount)
from account_payment as pay_trade
left join account_move as am on am.payment_id = pay_trade.id
left join account_move_line as aml on aml.move_id = am.id
left outer join account_partial_reconcile as apr on apr.credit_move_id = aml.id
left outer join account_move_line as inv_aml on inv_aml.id = apr.debit_move_id
left outer join account_move as invoice on invoice.id = inv_aml.move_id
left join account_account as aa on aa.id = aml.account_id
left join account_account_type as aat on aat.id = aa.user_type_id
                                       and aat.type = 'receivable'
									  
WHERE pay_trade.id = pay.id
and aat.type = 'receivable' and am.state != 'cancel' )as amount_trade_discount,

COALESCE((SELECT
SUM(line.price_subtotal)
from account_payment as pay_down
left join account_move as am on am.payment_id = pay_down.id
left join account_move_line as aml on aml.move_id = am.id
left outer join account_partial_reconcile as apr on apr.credit_move_id = aml.id
left outer join account_move_line as inv_aml on inv_aml.id = apr.debit_move_id
left outer join account_move as invoice on invoice.id = inv_aml.move_id
left outer join account_move_line line on ( line.move_id = invoice.id ) and line.is_deduct_down_payment = true


left join account_account as aa on aa.id = aml.account_id
left join account_account_type as aat on aat.id = aa.user_type_id
                                       and aat.type = 'receivable'
									  
WHERE pay_down.id = pay.id
and aat.type = 'receivable' and am.state != 'cancel'),0)as price_down_payment,

(SELECT
SUM(invoice.amount_tax)
from account_payment as pay_amount_tax
left join account_move as am on am.payment_id = pay_amount_tax.id
left join account_move_line as aml on aml.move_id = am.id
left outer join account_partial_reconcile as apr on apr.credit_move_id = aml.id
left outer join account_move_line as inv_aml on inv_aml.id = apr.debit_move_id
left outer join account_move as invoice on invoice.id = inv_aml.move_id


left join account_account as aa on aa.id = aml.account_id
left join account_account_type as aat on aat.id = aa.user_type_id
                                       and aat.type = 'receivable'
									  
WHERE pay_amount_tax.id = pay.id
and aat.type = 'receivable' and am.state != 'cancel') as amount_tax,
pay.amount_net as pay_amount_net,


COALESCE(line.display_type, '')  as display_type
from account_payment as pay
left join account_move as am on am.payment_id = pay.id
left join account_move_line as aml on aml.move_id = am.id
left outer join account_partial_reconcile as apr on apr.credit_move_id = aml.id
left outer join account_move_line as inv_aml on inv_aml.id = apr.debit_move_id
left outer join account_move as invoice on invoice.id = inv_aml.move_id
left outer join account_move_line line on ( line.move_id = invoice.id ) and (line.exclude_from_invoice_tab = False) and (line.is_trade_discount = False)

left join account_account as aa on aa.id = aml.account_id
left join account_account_type as aat on aat.id = aa.user_type_id
                                       and aat.type = 'receivable'


LEFT JOIN res_partner partner on ( partner.id = pay.partner_id )
LEFT JOIN	( select 
			 	name,
			 	client_order_ref,
			 	po_date,
			 	user_id,
			 	min(id) as id 
			 from sale_order 
			 group by 
			 	name,
			 	client_order_ref,
			 	po_date,
			 	user_id
			) sale on (  sale.name = line.customer_source_doc )
			
LEFT JOIN res_users salesperson on salesperson.id = sale.user_id

LEFT JOIN account_payment_term term on ( term.id = invoice.invoice_payment_term_id )
LEFT JOIN LATERAL (select case date_part('month',am.date)
					   			when 1 then 'Jan'
					   			when 2 then 'Feb'
								when 3 then 'Mar'
					   			when 4 then 'Apr'
								when 5 then 'May'
					   			when 6 then 'Jun'
								when 7 then 'Jul'
								when 8 then 'Aug'
								when 9 then 'Sep'
					   			when 10 then 'Oct'
					   			when 11 then 'Nov'
					   			when 12 then 'Dec'
					  	end as mth,
					  	case date_part('month',invoice.invoice_date_due)
					   			when 1 then 'Jan'
					   			when 2 then 'Feb'
								when 3 then 'Mar'
					   			when 4 then 'Apr'
								when 5 then 'May'
					   			when 6 then 'Jun'
								when 7 then 'Jul'
								when 8 then 'Aug'
								when 9 then 'Sep'
					   			when 10 then 'Oct'
					   			when 11 then 'Nov'
					   			when 12 then 'Dec'
					  	end as mth_due
		) mth
     ON true
LEFT JOIN LATERAL (select 
	concat(date_part('day',am.date),'-',mth.mth,'-',date_part('year',am.date)) as newdate,
	concat(date_part('day',invoice.invoice_date_due),'-',mth.mth_due,'-',date_part('year',invoice.invoice_date_due)) as newdate_due
) newdate
	ON true 
 $P!{ids} 
and aat.type = 'receivable' and am.state != 'cancel'

order by pay.id,line.id]]>
	</queryString>
