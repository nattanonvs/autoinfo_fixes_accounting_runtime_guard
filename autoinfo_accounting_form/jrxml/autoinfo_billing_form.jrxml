	</parameter>
	<queryString>
		<![CDATA[select 
	c.id AS company_id
	,COALESCE(c.company_name_thai,'') AS company_name_thai
	,COALESCE(c.company_name_en,'') AS company_name_en
	,COALESCE(c.company_tax_id,'') AS company_tax_id
	,COALESCE(c.company_branch,'00000') AS company_branch
	,encode(c.company_logo,'escape') AS company_logo      
	--,REPLACE(COALESCE(c.company_address_thai,''), COALESCE(ct.name, ''), '') AS company_address_thai
	,REPLACE(COALESCE((concat(cpart.street,
                                (case when cpart.street2 is not null then concat('\n', cpart.street2) else '' end), ' ',
                                cpart.city,
                                case when cp.name is not null then ' จังหวัด' else '' end,
                                cp.name, ' ', 
                                cpart.zip,
                                case when ct.name is not null then ' ' else '' end,
                                ct.name)), ''),COALESCE(ct.name, ''), '')  as company_address_thai
	,REPLACE(COALESCE(c.company_address_en,''), COALESCE(ct.name, ''), '') AS company_address_en
	,COALESCE(c.company_heaer_report,'') AS company_heaer_report
	,COALESCE(c.company_footer_report,'') AS company_footer_report
	,COALESCE(c.company_phone,'') AS company_phone
	,COALESCE(c.company_fax,'') AS company_fax
	,COALESCE(c.company_email,'') AS company_email
	,COALESCE(c.company_website,'') AS company_website
	
	,(SELECT a.name
		  FROM res_currency a
		  WHERE a.id=bill.currency_id
	)AS currency_name
	
	,COALESCE(partner.tax_name,'') as partner_tax_name
	,partner.vat as partner_tax_id
	,COALESCE(partner.branch_code,'00000' ) as partner_branch_code
	,COALESCE(partner.street,'' )as partner_street
	,COALESCE(partner.street2,'') as partner_street2
		
		,bill.name as bill_number
        ,bill.bill_date as bill_date
        ,bill.document_date as doc_date
        --,bill.actual_due_date as bill_due_date
        ,COALESCE(bill.billing_note,'') as billing_note
	    ,inv.name as invoice_number
        ,inv.invoice_date as invoice_date
        ,COALESCE(inv.actual_due_date,inv.invoice_date_due) as invoice_due_date
        ,pm.name as payment_method
        ,inv.move_type as invoice_type
        
       ,(case
				when inv.move_type='out_refund' then inv.amount_total*-1
				else inv.amount_total
		  end
		  )invoice_amount

		,(case
				when inv.move_type='out_refund' then inv.amount_residual*-1
				else inv.amount_residual
		  end
		  )invoice_residual
			
		,convert_num_th_with_currency((select sum(case when inv_detail.move_type='out_refund' then inv_detail.amount_residual*-1 else inv_detail.amount_residual end) as invoice_residual 
			from dtr_account_billing as bill_detail
			
			left join (	select * from account_move_dtr_account_billing_rel
					union all
				 select * from account_invoice_dtr_account_billing_attch
		 		 ) as bill_rel_detail on bill_rel_detail.dtr_account_billing_id = bill.id
		 		 
			inner join account_move as inv_detail on inv_detail.id = bill_rel_detail.account_move_id
			where bill_detail.id = bill.id ), bill.currency_id) as bill_amount_total_bahttext
			
		,convert_num_en_with_currency((select sum(case when inv_detail.move_type='out_refund' then inv_detail.amount_residual*-1 else inv_detail.amount_residual end) as invoice_residual 
			from dtr_account_billing as bill_detail
			
			left join (	select * from account_move_dtr_account_billing_rel
					union all
				 select * from account_invoice_dtr_account_billing_attch
		 		 ) as bill_rel_detail on bill_rel_detail.dtr_account_billing_id = bill.id
		 		 
			inner join account_move as inv_detail on inv_detail.id = bill_rel_detail.account_move_id
			where bill_detail.id = bill.id ),bill.currency_id) as bill_amount_total_engtext

	,bill.state AS state
	  -- *********************************************************************************************** For Prepare By
	  ,bill.write_date as prepare_date

	  ,(SELECT a.employee_name
		FROM company_employee_name a
		WHERE a.company_id=bill.company_id and a.user_id=bill.write_uid  limit 1
	  ) AS prepare_name
	 
	 ,(SELECT a.position_name
		FROM company_employee_name a
		WHERE a.company_id=bill.company_id and a.user_id=bill.write_uid  limit 1
	  ) AS prepare_position
	  
	   ,(SELECT a.department_name
		FROM company_employee_name a
		WHERE a.company_id=bill.company_id and a.user_id=bill.write_uid  limit 1
	  ) AS prepare_department
	  
	 ,(SELECT a.store_fname
		FROM company_employee_signature a
		WHERE a.company_id=bill.company_id and a.user_id=bill.write_uid  limit 1
	 ) AS prepare_signature
	 
	   -- *********************************************************************************************** For Pre Approval By
	   ,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='dtr.account.billing' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_approved_name
	   /*,(SELECT c.employee_name
		FROM company_final_approval a
		LEFT JOIN level_approval b on b.company_id=a.company_id and b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		LEFT JOIN company_employee_name c on c.company_id=b.company_id and c.user_id=b.decided_by_user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS pre_approved_name*/

	   ,(SELECT c.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_department c ON c.id = b.department_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='dtr.account.billing' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_department
	   	/*,(SELECT c.department_name
		FROM company_final_approval a
		LEFT JOIN level_approval b on b.company_id=a.company_id and b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		LEFT JOIN company_employee_name c on c.company_id=b.company_id and c.user_id=b.decided_by_user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS pre_department*/

	    ,(SELECT c.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_job c ON c.id = b.job_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='dtr.account.billing' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_position
		/*,(SELECT c.position_name
		FROM company_final_approval a
		LEFT JOIN level_approval b on b.company_id=a.company_id and b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		LEFT JOIN company_employee_name c on c.company_id=b.company_id and c.user_id=b.decided_by_user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS pre_position*/

		,(SELECT a.reviewed_date FROM (SELECT * FROM tier_review WHERE model='dtr.account.billing' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)AS pre_date_decided
		/*,(SELECT b.date_decided
		FROM company_final_approval a
		LEFT JOIN level_approval b on b.company_id=a.company_id and b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		LEFT JOIN company_employee_signature c on c.company_id=b.company_id and c.user_id=b.decided_by_user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS pre_date_decided*/

		,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='dtr.account.billing' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_signature
	   	/*,(SELECT c.store_fname
		FROM company_final_approval a
		LEFT JOIN level_approval b on b.company_id=a.company_id and b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		LEFT JOIN company_employee_signature c on c.company_id=b.company_id and c.user_id=b.decided_by_user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS pre_signature */
		
	  -- *********************************************************************************************** For Final Approval By
	  ,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='dtr.account.billing' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_name
	  /*,(SELECT b.employee_name
		FROM company_final_approval a
		LEFT JOIN company_employee_name b on b.company_id=a.company_id and a.decided_by_user_id=b.user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS approved_name*/

		,(SELECT c.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_department c ON c.id = b.department_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='dtr.account.billing' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_department
		/*,(SELECT b.department_name
		FROM company_final_approval a
		LEFT JOIN company_employee_name b on b.company_id=a.company_id and a.decided_by_user_id=b.user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS approved_department*/

		,(SELECT c.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_job c ON c.id = b.job_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='dtr.account.billing' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_position
		/*,(SELECT b.position_name
		FROM company_final_approval a
		LEFT JOIN company_employee_name b on b.company_id=a.company_id and a.decided_by_user_id=b.user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS approved_position*/

		,(SELECT reviewed_date FROM tier_review WHERE model='dtr.account.billing' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 1) AS approved_date_decided
		/*,(SELECT a.date_decided
		FROM company_final_approval a
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS approved_date_decided*/

		,'' as approved_status
		/*,(SELECT a.status
		FROM company_final_approval a
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS approved_status*/

		,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='dtr.account.billing' and res_id=bill.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_signature
		/*,(SELECT b.store_fname
		FROM company_final_approval a
		LEFT JOIN company_employee_signature b on b.company_id=a.company_id and a.decided_by_user_id=b.user_id
		WHERE a.company_id=bill.company_id and a.record_name=bill.name  limit 1
		) AS approved_signature */
	 -- *********************************************************************************************** 
	 ,COALESCE(ct.name, '') as company_country

from dtr_account_billing as bill
left join dtr_account_invoice_payment_method as pm on pm.id = bill.payment_method_id

left join (	select * from account_move_dtr_account_billing_rel
					union all
				 select * from account_invoice_dtr_account_billing_attch
		 		 ) as bill_rel on bill_rel.dtr_account_billing_id = bill.id

left join account_move as inv on inv.id = bill_rel.account_move_id 

left join	company_address_header_report c on ( c.id=bill.company_id )
left join	res_partner partner on ( partner.id = bill.partner_id )
left join res_company comp on comp.id = bill.company_id
left join res_partner cpart on cpart.id = comp.partner_id
left join res_country ct on ct.id = cpart.country_id
left join res_country_state cp on cp.id = cpart.state_id

$P!{ids}

order by bill.id,bill.id,invoice_due_date]]>
	</queryString>
