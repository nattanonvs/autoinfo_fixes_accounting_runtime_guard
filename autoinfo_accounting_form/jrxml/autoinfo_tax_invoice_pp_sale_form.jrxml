	<queryString>
		<![CDATA[SELECT
invoice.name as inv_no,
invoice.amount_untaxed, 
invoice.amount_untaxed_before_trade_discount,
invoice.amount_trade_discount,
invoice.amount_tax as amount_tax, 
invoice.amount_total as amount_total,
convert_num_th_with_currency(invoice.amount_total, invoice.currency_id) as total_word,
newdate.newdate as invoice_date, 
newdate.newdate_due as invoice_date_due, 
partner.tax_name as customer,
CONCAT(partner.street,' ',partner.street2) AS  partner_address,
COALESCE(partner.phone, '-') as partner_phone,
COALESCE(partner.fax, '-') as partner_fax,
COALESCE(partner.vat, '') as customer_tax_id,

(SELECT
case when tax.amount_type = 'percent' then concat(CAST(tax.amount AS INT), '%') 
else tax.amount::varchar
end as tax_text
FROM account_move_line aml
LEFT JOIN account_move_line_account_tax_rel aml_atx on aml_atx.account_move_line_id = aml.id
LEFT JOIN account_tax tax on tax.id = aml_atx.account_tax_id
where aml.move_id = invoice.id and aml.exclude_from_invoice_tab = False and aml.display_type is NULL
LIMIT 1) as tax,
case when sale2.id is not null then sale2.client_order_ref else sale.client_order_ref end as sale_ref,
case when sale2.id is not null then sale2.po_date else sale.po_date end as sale_ref_date,
term.name as payment_term,
line.name as line_name,
line.quantity as line_quantity,
line.price_unit as price_unit,
line.price_subtotal as price_subtotal,
(SELECT
--CONCAT(emp.name,' / ',COALESCE(dep.dtr_department_short, ''))
emp.name
FROM hr_employee emp
LEFT JOIN hr_department dep on dep.id = emp.department_id
WHERE emp.user_id = salesperson.id and emp.active = True
LIMIT 1) as salesperson,
(SELECT
dep.name
FROM hr_employee emp
LEFT JOIN hr_department dep on dep.id = emp.department_id
WHERE emp.user_id = salesperson.id and emp.active = True
LIMIT 1) as sale_department,
(SELECT
SUM(price_subtotal)
From account_move_line line
where move_id=invoice.id
and is_deduct_down_payment = true)as price_down_payment,
(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='account.move' and res_id=invoice.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_signature,
COALESCE(line.display_type, '')  as display_type,
project.job_no,
COALESCE(partner.branch_code, '') AS branch_code
FROM account_move invoice
LEFT JOIN res_partner partner on ( partner.id = invoice.partner_id )
LEFT JOIN account_move_line line on ( line.move_id = invoice.id ) and (line.exclude_from_invoice_tab = False) and (line.is_trade_discount = False)
LEFT JOIN	( select 
			 	name,
			 	client_order_ref,
			 	po_date,
			 	user_id,
			 	customer_project,
			 	min(id) as id 
			 from sale_order 
			 group by 
			 	name,
			 	client_order_ref,
			 	po_date,
			 	customer_project,
			 	user_id
			) sale on ( sale.name = (select line.customer_source_doc from account_move_line line where line.move_id = invoice.id and line.customer_source_doc is not null group by line.customer_source_doc limit 1))
LEFT JOIN	( select 
			 	so.name,
			 	so.client_order_ref,
			 	so.po_date,
			 	so.user_id,
			 	so.customer_project,
			 	min(so.id) as id ,
				sp.name as sp_name
			 from sale_order so
			 join stock_picking sp on sp.sale_id=so.id
			 group by 
			 	so.name,
			 	so.client_order_ref,
			 	so.po_date,
			 	so.customer_project,
			 	so.user_id,
				sp.name
			) sale2 on ( sale2.sp_name = (select line.customer_source_doc from account_move_line line where line.move_id = invoice.id and line.customer_source_doc is not null group by line.customer_source_doc limit 1))

LEFT JOIN res_users salesperson on salesperson.id = (case when sale2.id is not null then sale2.user_id else sale.user_id end)
LEFT JOIN project_project project on project.id = (case when sale2.id is not null then sale2.customer_project else sale.customer_project end)

LEFT JOIN account_payment_term term on ( term.id = invoice.invoice_payment_term_id )
LEFT JOIN LATERAL (select case date_part('month',invoice.invoice_date)
					   			when 1 then 'Jan'
					   			when 2 then 'Feb'
								when 3 then 'Mar'
					   			when 4 then 'Apr'
								when 5 then 'May'
					   			when 6 then 'Jun'
								when 7 then 'Jul'
								when 8 then 'Aug'
								when 9 then 'Sep'
					   			when 10 then 'Oct'
					   			when 11 then 'Nov'
					   			when 12 then 'Dec'
					  	end as mth,
					  	case date_part('month',invoice.invoice_date_due)
					   			when 1 then 'Jan'
					   			when 2 then 'Feb'
								when 3 then 'Mar'
					   			when 4 then 'Apr'
								when 5 then 'May'
					   			when 6 then 'Jun'
								when 7 then 'Jul'
								when 8 then 'Aug'
								when 9 then 'Sep'
					   			when 10 then 'Oct'
					   			when 11 then 'Nov'
					   			when 12 then 'Dec'
					  	end as mth_due
		) mth
     ON true
LEFT JOIN LATERAL (select 
	concat(date_part('day',invoice.invoice_date),'-',mth.mth,'-',date_part('year',invoice.invoice_date)) as newdate,
	concat(date_part('day',invoice.invoice_date_due),'-',mth.mth_due,'-',date_part('year',invoice.invoice_date_due)) as newdate_due
) newdate
	ON true 
 $P!{ids} 
ORDER BY invoice.id, line.sequence, line.id]]>
	</queryString>
