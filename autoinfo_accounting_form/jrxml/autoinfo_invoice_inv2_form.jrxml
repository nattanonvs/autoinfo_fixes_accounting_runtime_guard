	<queryString>
		<![CDATA[select		line.report_sequence  as rowid,
                line.display_type  as display_type,
				--tmp.id as flag,
				generate_series(1, 4) as flag,
				invoice.id, 
				invoice.invoice_date as date, 
				invoice.name as inv_no,
				invoice.invoice_date_due as delivery_date,
				invoice.amount_untaxed, 
				invoice.amount_untaxed_before_trade_discount,
				invoice.amount_trade_discount,
				invoice.amount_tax as tax, 
				invoice.amount_total as total,
				convert_num_th_with_currency(invoice.amount_total, invoice.currency_id) as total_word,
				convert_num_en_with_currency(invoice.amount_total,  invoice.currency_id) as total_word_en,
				invoice.ref as customer_reference,
				--coalesce(invoice.comment, '-') as remark,
				line.customer_source_doc as doc_no,
				line.quantity as qty, 
				btrim(regexp_replace(line.name, E'\\s+$', '  ', 'g')) as inv_description, 
				line.price_unit, 
				line.price_subtotal as subtotal,
				
				case when line.discount_type = 'percent' then concat(line.discount, '%')
				      when line.discount_type = 'amount_per_unit' then round((line.discount * line.quantity)::numeric, cur.decimal_places)::varchar
					  else line.discount::varchar
			    end as discount_text,
				--case when invoice.type = 'in_invoice'
					--then line.discount :: varchar
					--else translate(line.discount, '-', '' ) 
				--end as show_discount,
				--case when invoice.type = 'in_invoice'
					--then line.dtr_discount :: float
					--else translate(line.dynamic_discount, '-%', ' ' ) :: float
				--end as float_discount,
				--case when invoice.type = 'in_invoice'
					--then line.dtr_discount_type = 'percent' 
					--else	position('%' in line.dynamic_discount ) > 0
				--end as percent_discount,
				uom.name as uom,  
				product.default_code as product_code,
				--abs(coalesce(tax.amount,0)) as vat_order,
				abs(coalesce(tax.amount,0)) as vat_order,
				--tax.tax_exigibility,
				(select c.tax_exigibility from account_move_line a
					left join account_move_line_account_tax_rel b on b.account_move_line_id = a.id
					left join account_tax c on c.id = b.account_tax_id
					where a.move_id = invoice.id and a.exclude_from_invoice_tab = False and (a.display_type is null or a.display_type = '') limit 1) as tax_exigibility,
				term.name as payment_term, 
				partner.name as customer,
				CONCAT(partner.street,' ',partner.street2) AS  partner_address,
				partner.ref as customer_code,
				COALESCE(partner.vat, '') as customer_tax_id,
				COALESCE(partner.branch_code, '') as customer_branch_code,
				COALESCE(c.company_tax_id,'') as company_tax_id,
				COALESCE(c.company_branch,'') as company_branch,
				COALESCE(c.company_name_thai,'') as company_name_thai,
				COALESCE(c.company_name_en,'') as company_name_en,
				COALESCE(c.company_address_thai,'') as company_address_thai,
			    COALESCE(c.company_address_en,'') as company_address_en,
				COALESCE(c.company_address_thai,'') as company_address_thai,
				COALESCE(c.company_footer_report,'') as company_footer_report,
				COALESCE(c.company_phone,'') as company_phone,
				COALESCE(c.company_fax,'') as company_fax,
				COALESCE(c.company_email,'') AS company_email,
				COALESCE(c.company_website,'') AS company_website,
				encode(c.company_logo,'escape') as company_logo,
				coalesce(sale.id, 0 ) as sale_id,
				coalesce(picking.id, 0 ) as picking_id,
				case when sale.id is not null
					then
						( select b.name from sale_order a 
							left join res_partner b on ( a.partner_shipping_id = b.id ) where a.id = sale.id )
					else
						( select b.name from stock_picking a 
							left join res_partner b on ( a.partner_id = b.id ) where a.id = picking.id )
							end 
					as ship_to,
				invoice.narration as narration,
				(select partner.name from res_users u 
				left join res_partner partner on partner.id = u.partner_id
				where u.id = invoice.invoice_user_id limit 1)as salesperson,
				department.name as department,
				invoice.invoice_date_due,
				sale.date_order as so_date,
				(select job_no from project_project project where project.id = sale.customer_project limit 1)as job_no
				--(	select	string_agg(distinct customer_po, ', ')
				--	from	sale_order
				--	where	position( name in invoice.origin_second ) > 0  or
				--				position( name in (	select string_agg(origin, ', ') 
				--												from stock_picking
				--												where position( name in invoice.origin_third ) > 0  )) > 0
				--) as po_no,
				--concat(
				--	case when partner.dtr_address_no is not null then concat( 'เลขที่ ', partner.dtr_address_no ) else '' end 
				--	,case when partner.dtr_moo is not null then concat( ' หมู่ ', partner.dtr_moo ) else '' end 
				--	,case when partner.dtr_building is not null then concat( ' อาคาร', partner.dtr_building ) else '' end 
				--	) as cust_addr_line1,
				--concat(
				--	case when partner.dtr_soi is not null then concat( 'ซอย', partner.dtr_soi ) else '' end 
				 --	,case when partner.dtr_street is not null then concat( ' ถนน', partner.dtr_street ) else '' end 
				--	) as cust_addr_line2,
				--concat(
				--	case when partner.dtr_sub_district is not null 
				--			then concat(case partner.dtr_province when 1 then 'แขวง' else 'ตำบล' end, partner.dtr_sub_district ) 
				--			else ''
				--	end 
				--	,case when partner.dtr_district is not null 
				--			then concat( case partner.dtr_province when 1 then ' เขต' else ' อำเภอ' end, 
				--				(	select b.name
				--					from dtr_address_district b
				--					where b.id=partner.dtr_district ) ) 
				--			else ''
				--	end 
				--	) as cust_addr_line3,
				--concat(
				--	case when partner.dtr_province is not null 
				--			then concat(case partner.dtr_province when 1 then '' else  'จังหวัด' end, 
				--				(	select b.name
				--					from dtr_address_province b
				--					where b.id=partner.dtr_province ) ) 
				--			else ''
				--	end,
				--	' ',
				--	coalesce(partner.zip,'')
				--	) as cust_addr_line4,
				--( select count(id) from dtr_sale_order_note where sale_id = sale.id ) as note_cnt
				
				,sale.client_order_ref as so_client_order_ref,
				sale.po_date as so_po_date
from		account_move invoice
left join res_currency cur on cur.id = invoice.currency_id
left join	account_move_line line on ( line.move_id = invoice.id ) and (line.exclude_from_invoice_tab = False or line.exclude_from_invoice_tab is null) and ( line.display_type is null)
left join	account_move_line_account_tax_rel tax_rel on ( tax_rel.account_move_line_id = line.id )
left join	account_tax tax on ( tax.id = tax_rel.account_tax_id )
left join	product_product product on ( product.id = line.product_id )
left join	product_template template on ( template.id = product.product_tmpl_id )
left join	uom_uom uom on ( uom.id = line.product_uom_id )
left join	account_payment_term term on ( term.id = invoice.invoice_payment_term_id )
left join	company_address_header_report c on ( c.id=invoice.company_id )
left join	res_partner partner on ( partner.id = invoice.partner_id )
left join	( select name, max(id) as id from stock_picking group by name ) picking on ( picking.name = line.customer_source_doc )
left join	( select name, client_order_ref, po_date,customer_project, date_order, min(id) as id from sale_order group by name, client_order_ref, po_date, date_order,customer_project ) sale on (  sale.name =invoice.origin_second )
left join hr_department department on department.id = invoice.department_id
$P!{ids}
ORDER BY invoice.id,flag, line.sequence, line.id]]>
	</queryString>
