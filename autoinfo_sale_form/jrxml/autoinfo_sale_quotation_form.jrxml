<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version 6.6.0.final using JasperReports Library version 6.6.0  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="autoinfo_sale_quotation_form" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8f72a463-64e4-4b71-ab9c-a3e1e7e0679e">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Localhost"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="270"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="725"/>
	<style name="Section Line">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{display_type}.toString().equals("line_section")]]></conditionExpression>
			<style mode="Opaque" backcolor="#DBDBDB"/>
		</conditionalStyle>
	</style>
	<parameter name="p_Where" class="java.lang.String">
		<defaultValueExpression><![CDATA["WHERE so.id  in (34)"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Company_No" class="java.lang.Integer" isForPrompting="false">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="p_ISO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["ISO Number"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_language" class="java.lang.String">
		<defaultValueExpression><![CDATA["eng"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_DateFormat" class="java.lang.String">
		<defaultValueExpression><![CDATA["dd-MM-yyyy"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_locale" class="java.lang.String">
		<defaultValueExpression><![CDATA["th"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Path" class="java.lang.String">
		<defaultValueExpression><![CDATA["/home/dtr0048/DTR/Filestores/filestore/v15_autoinfo/"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_EName" class="java.lang.Boolean"/>
	<parameter name="p_ESignature" class="java.lang.Boolean"/>
	<queryString>
		<![CDATA[SELECT sl.report_sequence as seq
	,att.store_fname AS logo_iso
    ,c.id AS company_id
	,COALESCE(c.company_name_thai,'') AS company_name_thai
	,COALESCE(c.company_name_en,'') AS company_name_en
	,COALESCE(c.company_tax_id,'') AS company_tax_id
	,COALESCE(c.company_branch,'00000') AS company_branch
	,encode(c.company_logo,'escape') AS company_logo      
	,COALESCE(c.company_address_thai,'') AS company_address_thai
	,COALESCE(c.company_address_en,'') AS company_address_en
	,COALESCE(c.company_heaer_report,'') AS company_heaer_report
	,COALESCE(c.company_footer_report,'') AS company_footer_report
	,COALESCE(c.company_phone,'') AS company_phone
	,COALESCE(c.company_fax,'') AS company_fax
	,COALESCE(c.company_email,'') AS company_email
	,COALESCE(c.company_website,'') AS company_website

	,so.id AS so_id
	,so.name
	,so.date_order AS confirmation_date
	,EXTRACT(YEAR FROM date(so.date_order)) AS sale_year
	,EXTRACT(MONTH FROM date(so.date_order)) AS sale_month
	,to_char( so.date_order, 'YYYY-MM') AS sale_year_month
	
	,(SELECT b.name
	    FROM res_users a 
	    LEFT JOIN hr_employee b on b.id=so.user_id
	    WHERE a.id=so.user_id
	  ) AS sale_name

	,pn.ref AS customer_code
	,pn.display_name AS customer_name
	,COALESCE(pn.default_contact_name,'') AS customer_contact
	
	,COALESCE(pn.phone,'') AS customer_phone
    ,COALESCE(pn.mobile, '') as customer_mobile
	,COALESCE(pn.fax,'') AS customer_fax
	,COALESCE(pn.vat,'') AS customer_tax
	,COALESCE(pn.branch_code,'') AS customer_branch
	,COALESCE(pn.email,'') AS customer_email
	
	,COALESCE((SELECT pn.name
		FROM res_partner pn
		WHERE pn.id=so.partner_shipping_id AND pn.company_id=so.company_id 
	 ), '')AS customer_shipping_name
	 
	 ,COALESCE((SELECT hr.name_en
		FROM hr_employee hr
		WHERE hr.user_id = so.user_id and (hr.company_id = so.company_id or hr.company_id is null) limit 1
	  ),'')AS sale_person1_en
	
	,COALESCE((SELECT hr.name
	 	FROM hr_employee hr
		WHERE hr.user_id = so.user_id and (hr.company_id = so.company_id or hr.company_id is null) limit 1
	  ),'')AS sale_person1_thai
	  
	  ,COALESCE((SELECT hr.mobile_phone
	 	FROM hr_employee hr
		WHERE hr.user_id = so.user_id and (hr.company_id = so.company_id or hr.company_id is null) limit 1
	  ),'')AS sale_person1_mobile_phone
	  
	  ,COALESCE((SELECT hr.work_phone
	 	FROM hr_employee hr
		WHERE hr.user_id = so.user_id and (hr.company_id = so.company_id or hr.company_id is null) limit 1
	  ),'')AS sale_person1_work_phone

	 ,COALESCE((SELECT hr.name_en
	 	FROM hr_employee hr
		WHERE hr.user_id = so.user2_id and (hr.company_id = so.company_id or hr.company_id is null) limit 1
	  ),'')AS sale_person2_en
	
	,COALESCE((SELECT hr.name
	 	FROM hr_employee hr
		WHERE hr.user_id = so.user2_id and (hr.company_id = so.company_id or hr.company_id is null) limit 1
	  ),'')AS sale_person2_thai  
	
	,COALESCE((SELECT hr.mobile_phone
	 	FROM hr_employee hr
		WHERE hr.user_id = so.user2_id and (hr.company_id = so.company_id or hr.company_id is null) limit 1
	  ),'')AS sale_person2_mobile_phone 
	
	,COALESCE((SELECT hr.work_phone
	 	FROM hr_employee hr
		WHERE hr.user_id = so.user2_id and (hr.company_id = so.company_id or hr.company_id is null) limit 1
	  ),'')AS sale_person2_work_phone 
	  
	  ,COALESCE((SELECT hr.work_email
	 	FROM hr_employee hr
		WHERE hr.user_id = so.user_id and (hr.company_id = so.company_id or hr.company_id is null) limit 1
	  ),'')AS sale_person1_work_email
	  
	  ,COALESCE((SELECT job.name
	 	FROM hr_employee hr
	 	LEFT JOIN hr_job job ON job.id = hr.job_id
		WHERE hr.user_id = so.user_id and (hr.company_id = so.company_id or hr.company_id is null) limit 1
	  ),'')AS sale_person1_position
	  
	  	,(SELECT att.store_fname FROM hr_employee hr
		LEFT JOIN ir_attachment att ON att.res_id = hr.id and att.res_model = 'hr.employee' and att.res_field='signature'
		WHERE hr.user_id = so.user_id and (hr.company_id = so.company_id or hr.company_id is null) limit 1) AS sale_person1_signature
	  
	,COALESCE(pn1.display_name,'') AS customer_shipping_contact
	,COALESCE(pn1.phone,'') AS customer_shipping_phone
	,COALESCE(pn1.fax,'') AS customer_shipping_fax
	,COALESCE(pn1.branch_code,'') AS customer_shipping_branch
	
	,COALESCE(pn2.display_name,'') AS customer_invoice_contact
	,COALESCE(pn2.phone,'') AS customer_invoice_phone
	,COALESCE(pn2.fax,'') AS customer_invoice_fax
	,COALESCE(pn2.branch_code,'') AS customer_invoice_branch
	
	,(SELECT a.name
		FROM account_payment_term a
		WHERE a.id=so.payment_term_id
	 )AS payment_term

	,pn.street as partner_address
	,pn.street2 as partner_address2
	,pn1.street as partner_shipping_address
	,pn1.street2 as partner_shipping_address2
	,pn2.street as partner_invoice_address
	,pn2.street2 as partner_invoice_address2
	,so.plan_delivery_date
	,so.effective_date
		
	,replace(replace(sl.name,chr(10),'<br>'), concat('[',pro.default_code,']'), '') AS product_name
	,pro.default_code AS product_code
	,sl.product_uom_qty AS so_qty
	,pu.name AS product_uom
	,sl.price_unit AS product_unitprice
	,sl.discount_total AS product_discount
	--,sl.dynamic_discount AS product_discount
	,sl.price_reduce
	,sl.price_subtotal 
	,so.note
	
	,	(SELECT max(b.amount) 
		  FROM account_tax_sale_order_line_rel a
		  LEFT JOIN account_tax b ON b.id=a.account_tax_id
		  LEFT JOIN sale_order_line c ON c.id=a.sale_order_line_id
		  LEFT JOIN sale_order d ON d.id=c.order_id
		  --WHERE a.sale_order_line_id=sl.id
		  WHERE d.id = so.id
		 )AS so_taxes
		
	,	(SELECT a.name
		  FROM res_currency a
		  WHERE a.id=sl.currency_id
		 )AS currency_name
		
	,so.exchange_rate
	,so.client_order_ref
	,so.amount_untaxed
	,so.amount_trade_discount
	,so.amount_untaxed_before_trade_discount as amount_untaxed_before_trade_discount
	,so.amount_untaxed as amount_untaxed_trade_discount
	--,so.amount_special_discount
	--,so.amount_promotion_discount
	,so.amount_untaxed as amount_subtotal_before_tax
	,so.amount_tax
	,so.amount_total	 
		
	,convert_num_th_with_currency(so.amount_total, sl.currency_id) AS so_amout_total_bahttext
	,convert_num_en_with_currency(so.amount_total,sl.currency_id) AS so_amout_total_engtext

	,so.state
	,so.client_order_ref
	,sl.price_subtotal AS amount_total_item
	,sl.product_uom_qty
	,sl.qty_delivered
	,sl.display_type
	
	--,sc.sequence AS category_sequence
	--,COALESCE(sc.name,sl.name)  AS category_name
	--,sc.subtotal as category_subtotal
	--,sc.display_detail as category_display_detail
	--,sc.display_detail_price as category_display_detail_price
	
	,so.state AS state
	   -- *********************************************************************************************** For Prepare By
	  ,so.write_date as prepare_date
	  
	  ,(SELECT a.employee_name
		FROM company_employee_name a
		WHERE a.user_id=so.create_uid  limit 1
	  ) AS prepare_name
	 
	 ,(SELECT a.position_name
		FROM company_employee_name a
		WHERE a.user_id=so.create_uid  limit 1
	  ) AS prepare_position
	  
	   ,(SELECT a.department_name
		FROM company_employee_name a
		WHERE a.user_id=so.create_uid  limit 1
	  ) AS prepare_department
	  
	 ,(SELECT a.store_fname
		FROM company_employee_signature a
		WHERE a.user_id=so.create_uid  limit 1
	 ) AS prepare_signature
	 
	   -- *********************************************************************************************** For Pre Approval By
	   ,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='sale.order' and res_id=so.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_approved_name
	   --,(SELECT c.employee_name
		--FROM company_final_approval a
		--LEFT JOIN level_approval b on b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		--LEFT JOIN company_employee_name c on c.user_id=b.decided_by_user_id
		--WHERE a.record_name=so.name  limit 1
		--) AS pre_approved_name

	   ,(SELECT c.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_department c ON c.id = b.department_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='sale.order' and res_id=so.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_department
	   	--,(SELECT c.department_name
		--FROM company_final_approval a
		--LEFT JOIN level_approval b on b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		--LEFT JOIN company_employee_name c on c.user_id=b.decided_by_user_id
		--WHERE a.record_name=so.name  limit 1
		--) AS pre_department

	    ,(SELECT c.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_job c ON c.id = b.job_id
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='sale.order' and res_id=so.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_position
		--,(SELECT c.position_name
		--FROM company_final_approval a
		--LEFT JOIN level_approval b on b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		--LEFT JOIN company_employee_name c on c.user_id=b.decided_by_user_id
		--WHERE a.record_name=so.name  limit 1
		--) AS pre_position

		,(SELECT a.reviewed_date FROM (SELECT * FROM tier_review WHERE model='sale.order' and res_id=so.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)AS pre_date_decided
		--,(SELECT b.date_decided
		--FROM company_final_approval a
		--LEFT JOIN level_approval b on b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		--LEFT JOIN company_employee_signature c on c.user_id=b.decided_by_user_id
		--WHERE a.record_name=so.name  limit 1
		--) AS pre_date_decided

		,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = (SELECT a.done_by FROM (SELECT * FROM tier_review WHERE model='sale.order' and res_id=so.id and status='approved' ORDER BY sequence DESC LIMIT 2) a ORDER BY a.sequence LIMIT 1)) AS pre_signature
	   	--,(SELECT c.store_fname
		--FROM company_final_approval a
		--LEFT JOIN level_approval b on b.record_name=a.record_name and b.level_seq=a.previous_level_seq
		--LEFT JOIN company_employee_signature c on c.user_id=b.decided_by_user_id
		--WHERE  a.record_name=so.name  limit 1
		--) AS pre_signature
		
	  -- *********************************************************************************************** For Final Approval By
	  --,(SELECT done_by FROM tier_review WHERE model='sale.order' and res_id=so.id ORDER BY sequence DESC LIMIT 1) AS tier_id

	  ,(SELECT b.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='sale.order' and res_id=so.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_name
		,(SELECT b.name_en FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='sale.order' and res_id=so.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_name_en
	  --,(SELECT b.employee_name
		--FROM company_final_approval a
		--LEFT JOIN company_employee_name b on a.decided_by_user_id=b.user_id
		--WHERE a.record_name=so.name  limit 1
		--) AS approved_name

		,(SELECT c.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_department c ON c.id = b.department_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='sale.order' and res_id=so.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_department
		--,(SELECT b.department_name
		--FROM company_final_approval a
		--LEFT JOIN company_employee_name b on a.decided_by_user_id=b.user_id
		--WHERE a.record_name=so.name  limit 1
		--) AS approved_department

		,(SELECT c.name FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN hr_job c ON c.id = b.job_id
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='sale.order' and res_id=so.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_position
		--,(SELECT b.position_name
		--FROM company_final_approval a
		--LEFT JOIN company_employee_name b on a.decided_by_user_id=b.user_id
		--WHERE a.record_name=so.name  limit 1
		--) AS approved_position

		,(SELECT reviewed_date FROM tier_review WHERE model='sale.order' and res_id=so.id and status='approved' ORDER BY sequence DESC LIMIT 1) AS approved_date_decided
		--,(SELECT a.date_decided
		--FROM company_final_approval a
		--WHERE a.record_name=so.name  limit 1
		--) AS approved_date_decided

		--,(SELECT a.status
		--FROM company_final_approval a
		--WHERE a.record_name=so.name  limit 1
		--) AS approved_status

	,(SELECT c.store_fname FROM resource_resource a
		LEFT JOIN hr_employee b ON a.id = b.resource_id
		LEFT JOIN ir_attachment c ON c.res_id = b.id and c.res_model = 'hr.employee' and c.res_field='signature'
		WHERE a.user_id = (SELECT done_by FROM tier_review WHERE model='sale.order' and res_id=so.id and status='approved' ORDER BY sequence DESC LIMIT 1)) AS approved_signature
	--,(SELECT b.store_fname
		--FROM company_final_approval a
		--LEFT JOIN company_employee_signature b on a.decided_by_user_id=b.user_id
		--WHERE a.record_name=so.name  limit 1
	--) AS approved_signature
	 -- ***********************************************************************************************
	 ,COALESCE(pn.default_contact_name, '') as default_contact_name
	 ,COALESCE(so.your_ref, '') as your_ref
	 ,COALESCE(proj.name, '') as project_name
	 ,COALESCE(sdr.description, '') as delivery_report
	 ,COALESCE(svr.description, '') as validaity_report
	 ,COALESCE(swr.description, '') as warranty_report
	 ,COALESCE(scr.description, '') as credit_report
	 ,COALESCE(sppr.description, '') as payment_product
	 ,COALESCE(sper.description, '') as payment_engineering
	 ,COALESCE(spr.description, '') as price_report
	 ,COALESCE(so.project_name_report, '') as project_name_report
	 
FROM sale_order so
LEFT JOIN sale_order_line sl on sl.order_id=so.id
LEFT JOIN product_product as pro on pro.id = sl.product_id
--LEFT JOIN sale_layout_category sc ON sc.id=sl.layout_category_id
LEFT JOIN company_address_header_report c ON c.id=so.company_id
LEFT JOIN res_company comp ON comp.id = so.company_id
LEFT JOIN ir_attachment att ON att.res_id = comp.id and att.res_model = 'res.company' and att.res_field='logo_iso'

LEFT JOIN res_partner pn ON pn.id=so.partner_id
LEFT JOIN dtr_prefix_partner pp on pp.id=pn.dtr_prefix_partner_id

LEFT JOIN res_partner pn1 ON pn1.id=so.partner_shipping_id
LEFT JOIN dtr_prefix_partner pp1 on pp1.id=pn1.dtr_prefix_partner_id

LEFT JOIN res_partner pn2 ON pn2.id=so.partner_invoice_id
LEFT JOIN dtr_prefix_partner pp2 on pp2.id=pn2.dtr_prefix_partner_id

LEFT JOIN uom_uom pu on pu.id=sl.product_uom
LEFT JOIN resource_resource res on ( res.user_id = so.create_uid and res.company_id = so.company_id )
LEFT JOIN hr_employee hr on hr.id=res.id
LEFT JOIN project_project proj on so.customer_project = proj.id
LEFT JOIN dtr_sale_price_report spr ON spr.id = so.dtr_sale_price_report_id
LEFT JOIN dtr_sale_delivery_report sdr ON sdr.id = so.dtr_sale_delivery_report_id
LEFT JOIN dtr_sale_payment_product_report sppr ON sppr.id = so.dtr_sale_payment_product_report_id
LEFT JOIN dtr_sale_payment_engineering_report sper ON sper.id = so.dtr_sale_payment_engineering_report_id
LEFT JOIN dtr_sale_validity_report svr ON svr.id = so.dtr_sale_validity_report_id
LEFT JOIN dtr_sale_warranty_report swr ON swr.id = so.dtr_sale_warranty_report_id
LEFT JOIN dtr_sale_credit_report scr ON scr.id = so.dtr_sale_credit_report_id
$P!{p_Where} 
  and (sl.is_trade_discount is null or sl.is_trade_discount = false)
ORDER BY so.id, sl.sequence, sl.id]]>
	</queryString>
	<field name="seq" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="seq"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sale_order_line"/>
	</field>
	<field name="logo_iso" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="logo_iso"/>
	</field>
	<field name="company_id" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="company_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="company_address_header_report"/>
	</field>
	<field name="company_name_thai" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_name_thai"/>
	</field>
	<field name="company_name_en" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_name_en"/>
	</field>
	<field name="company_tax_id" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_tax_id"/>
	</field>
	<field name="company_branch" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_branch"/>
	</field>
	<field name="company_logo" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_logo"/>
	</field>
	<field name="company_address_thai" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_address_thai"/>
	</field>
	<field name="company_address_en" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_address_en"/>
	</field>
	<field name="company_heaer_report" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_heaer_report"/>
	</field>
	<field name="company_footer_report" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_footer_report"/>
	</field>
	<field name="company_phone" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_phone"/>
	</field>
	<field name="company_fax" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_fax"/>
	</field>
	<field name="company_email" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_email"/>
	</field>
	<field name="company_website" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_website"/>
	</field>
	<field name="so_id" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="so_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sale_order"/>
	</field>
	<field name="name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="name"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sale_order"/>
	</field>
	<field name="confirmation_date" class="java.sql.Timestamp">
