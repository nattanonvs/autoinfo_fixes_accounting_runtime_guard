		<property name="com.jaspersoft.studio.field.label" value="company_tax_id"/>
	</field>
	<field name="company_branch" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_branch"/>
	</field>
	<field name="company_logo" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_logo"/>
	</field>
	<field name="company_address_thai" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_address_thai"/>
	</field>
	<field name="company_address_en" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_address_en"/>
	</field>
	<field name="company_heaer_report" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_heaer_report"/>
	</field>
	<field name="company_footer_report" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_footer_report"/>
	</field>
	<field name="company_phone" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_phone"/>
	</field>
	<field name="company_fax" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_fax"/>
	</field>
	<field name="company_email" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_email"/>
	</field>
	<field name="company_website" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="company_website"/>
	</field>
	<field name="so_id" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="so_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sale_order"/>
	</field>
	<field name="name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="name"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sale_order"/>
	</field>
	<field name="confirmation_date" class="java.sql.Timestamp">
		<property name="com.jaspersoft.studio.field.label" value="confirmation_date"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="sale_order"/>
	</field>
	<field name="sale_year" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="sale_year"/>
	</field>
	<field name="sale_month" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="sale_month"/>
	</field>
	<field name="sale_year_month" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="sale_year_month"/>
	</field>
	<field name="sale_name" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="sale_name"/>
	</field>
	<field name="customer_code" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="customer_code"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="res_partner"/>
