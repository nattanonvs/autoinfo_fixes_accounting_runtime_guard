<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="sale_order_form" model="ir.ui.view">
            <field name="name">sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <field name="partner_shipping_id" position="after">
                    <field name="your_ref"/>
                </field>
                <xpath expr="//notebook" position="inside">
                    <page name="sale_report" string="Report">
                        <group>
                            <group>
                                <field name="dtr_sale_price_report_id"/>
                                <field name="dtr_sale_delivery_report_id"/>
                                <field name="dtr_sale_payment_product_report_id"/>
                                <field name="dtr_sale_payment_engineering_report_id"/>
                            </group>
                            <group>
                                <field name="dtr_sale_validity_report_id"/>
                                <field name="dtr_sale_warranty_report_id"/>
                                <field name="dtr_sale_credit_report_id"/> 
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>